{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Jstn-1g/dsh-guarded-hcl/main/schemas/trial-manifest-v0.1.schema.json",
  "title": "Guarded HCL TrialManifest v0.1",
  "description": "Closed declaration of the exact identities, references, metric definitions, and ordered paired-trial set used by a future scorecard run. This document does not execute an evaluator or prove that the declarations are truthful.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "identities",
    "baseline",
    "candidate",
    "runnerBindingRef",
    "currentTask",
    "retentionAnchors",
    "validityChecks",
    "cost",
    "trialIds"
  ],
  "properties": {
    "schemaVersion": { "const": "0.1" },
    "identities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task", "model", "environment", "dataset", "grader"],
      "properties": {
        "task": { "$ref": "#/$defs/identifier" },
        "model": { "$ref": "#/$defs/identifier" },
        "environment": { "$ref": "#/$defs/identifier" },
        "dataset": { "$ref": "#/$defs/identifier" },
        "grader": { "$ref": "#/$defs/identifier" }
      }
    },
    "baseline": { "$ref": "#/$defs/subject" },
    "candidate": { "$ref": "#/$defs/subject" },
    "runnerBindingRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaUri", "digestProfile", "digest"],
      "properties": {
        "schemaUri": {
          "const": "https://raw.githubusercontent.com/Jstn-1g/dsh-guarded-hcl/main/schemas/runner-binding-v0.1.schema.json"
        },
        "digestProfile": {
          "const": "urn:dsh-guarded-hcl:digest-profile:jcs-sha256:v0.1"
        },
        "digest": { "$ref": "#/$defs/sha256Digest" }
      }
    },
    "currentTask": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "direction"],
      "properties": {
        "metric": { "$ref": "#/$defs/identifier" },
        "direction": { "const": "maximize" }
      }
    },
    "retentionAnchors": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/identifier" },
      "additionalProperties": { "$ref": "#/$defs/retentionAnchor" }
    },
    "validityChecks": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/identifier" },
      "additionalProperties": { "$ref": "#/$defs/validityCheck" }
    },
    "cost": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["metric"],
          "properties": {
            "metric": { "$ref": "#/$defs/identifier" }
          }
        },
        { "type": "null" }
      ]
    },
    "trialIds": {
      "type": "array",
      "minItems": 2,
      "maxItems": 30,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" },
      "description": "Unique paired-trial identifiers in the exact order used by deterministic aggregation."
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:[\\u0000-\\uD7FF\\uE000-\\u{10FFFF}])+$",
      "description": "Opaque, case-sensitive identifier containing Unicode scalar values only. No trimming or Unicode normalization is applied."
    },
    "sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "schemaUri": {
      "type": "string",
      "pattern": "^(?:https://[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)*(?::(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?(?:/(?:[A-Za-z0-9._~!$&'()*+,;=:@-]|%[0-9A-Fa-f]{2})*)*(?:\\?(?:[A-Za-z0-9._~!$&'()*+,;=:@/?-]|%[0-9A-Fa-f]{2})*)?(?:#(?:[A-Za-z0-9._~!$&'()*+,;=:@/?-]|%[0-9A-Fa-f]{2})*)?|urn:[a-z0-9][a-z0-9-]{0,30}[a-z0-9]:(?:[A-Za-z0-9._~!$&'()*+,;=:@/-]|%[0-9A-Fa-f]{2})+(?:\\?(?:[A-Za-z0-9._~!$&'()*+,;=:@/?-]|%[0-9A-Fa-f]{2})*)?(?:#(?:[A-Za-z0-9._~!$&'()*+,;=:@/?-]|%[0-9A-Fa-f]{2})*)?)$"
    },
    "recipeReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recipeId", "schemaUri", "digestProfile", "digest"],
      "properties": {
        "recipeId": { "$ref": "#/$defs/identifier" },
        "schemaUri": { "$ref": "#/$defs/schemaUri" },
        "digestProfile": {
          "const": "urn:dsh-guarded-hcl:digest-profile:jcs-sha256:v0.1"
        },
        "digest": { "$ref": "#/$defs/sha256Digest" }
      }
    },
    "artifactIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "kind", "digest"],
      "properties": {
        "profile": {
          "const": "urn:dsh-guarded-hcl:digest-profile:artifact-jcs-sha256:v0.1"
        },
        "kind": { "enum": ["tree", "blob"] },
        "digest": { "$ref": "#/$defs/sha256Digest" }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recipe", "artifact"],
      "properties": {
        "recipe": { "$ref": "#/$defs/recipeReference" },
        "artifact": { "$ref": "#/$defs/artifactIdentity" }
      }
    },
    "retentionAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "direction", "required", "weight", "maximumLoss"],
      "properties": {
        "metric": { "$ref": "#/$defs/identifier" },
        "direction": { "const": "maximize" },
        "required": { "type": "boolean" },
        "weight": { "type": "number", "exclusiveMinimum": 0 },
        "maximumLoss": { "type": "number", "minimum": 0 }
      }
    },
    "validityCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity"],
      "properties": {
        "severity": { "$ref": "#/$defs/identifier" }
      }
    }
  }
}
