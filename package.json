{
  "name": "dsh-guarded-hcl",
  "version": "0.1.0",
  "description": "A portable, code-owned retention and commit gate for guarded Harness Continual Learning in DeepSeek Harness ecosystems.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "author": "Justin Skowyra",
  "keywords": [
    "deepseek-harness",
    "continual-learning",
    "agent-harness",
    "evaluation",
    "retention",
    "rollback"
  ],
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/index.js",
    "./gate": "./src/gate.js",
    "./canonical": "./src/canonical.js"
  },
  "bin": {
    "hcl-gate": "./bin/hcl-gate.js"
  },
  "files": [
    "bin",
    "docs",
    "examples",
    "schemas",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node --check src/canonical.js && node --check src/gate.js && node --check src/index.js && node --check bin/hcl-gate.js && node --check test/gate.test.js",
    "example:pass": "node ./bin/hcl-gate.js ./examples/policy.json ./examples/evaluation-pass.json",
    "example:reject": "node ./bin/hcl-gate.js ./examples/policy.json ./examples/evaluation-regression.json"
  }
}
